# Copy this file to .env (local dev) and set the same keys in your Vercel
# project's Environment Variables (Settings → Environment Variables).
# Never commit the real .env file — it's gitignored.

# ── Required ──────────────────────────────────────────────────────────────

# Anthropic API key — powers the agent (briefings, drafts, pipeline updates).
ANTHROPIC_API_KEY=

# Password that protects your dashboard and all /api/pipeline calls.
# Pick a long random string. Set the same value in the dashboard's login screen.
DASHBOARD_SECRET=

# Vercel KV (Upstash Redis) — add the "KV" integration from your Vercel
# project's Storage tab; it auto-populates these two.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ── Optional: enables the Vercel Cron jobs to authenticate ─────────────────
# Vercel sets this automatically for Cron-triggered requests if you define it
# here; used by api/scrape.js to accept scheduled runs without the dashboard secret.
CRON_SECRET=

# ── Optional: Gmail + Calendar integration ─────────────────────────────────
# Skip this whole section if you don't want the agent reading/drafting email.
# See docs/SETUP.md for the full Google Cloud Console walkthrough.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# ── Optional: Gmail push notifications (real-time instead of daily poll) ──
GOOGLE_PUBSUB_PROJECT_ID=
GOOGLE_PUBSUB_TOKEN=
GOOGLE_PUBSUB_TOPIC=job-search-gmail-watch

# ── Optional: model override ────────────────────────────────────────────────
# Defaults to claude-sonnet-4-6 if unset.
ANTHROPIC_MODEL=

# ── Optional: external sprint/task board integration ───────────────────────
# If set, the agent's post_sprint_task tool will POST tasks to {SPRINT_BOARD_URL}/api/tasks,
# and the dashboard's cost tab will read {SPRINT_BOARD_URL}/api/sprints as a
# fallback token source when the KV token log is empty.
# Leave unset to disable — the tool becomes a no-op and the dashboard skips it.
SPRINT_BOARD_URL=
